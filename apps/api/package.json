{
  "name": "@seduc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:bootstrap-admin": "tsx src/scripts/bootstrap-admin.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@seduc/contracts": "workspace:*",
    "@seduc/database": "workspace:*",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
